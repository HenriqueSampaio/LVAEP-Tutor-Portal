# Copy this file to .env and fill it in. .env is git-ignored — never commit it.
# Leave a line out (or empty) to use the default.

# ---- Database ----
# Empty: a local SQLite file (data/lvaep.sqlite3), no setup needed.
# Supabase: Connect button -> "Session pooler" string, with your database password filled in.
DATABASE_URL=
# DATABASE_URL=postgresql://postgres.abcdefghijklmnop:YOUR-DB-PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# Optional, only for `python3 check_setup.py`: confirms Supabase's public API can't read the tables.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# ---- Email (https://resend.com) ----
# Empty: emails are saved to data/outbox/ as .html files instead of being sent.
RESEND_API_KEY=
# Until LVAEP's domain is verified in Resend, keep the onboarding@resend.dev sender;
# Resend then only delivers to the email address on your Resend account.
EMAIL_FROM=LVAEP Tutor Hours <onboarding@resend.dev>
EMAIL_REPLY_TO=
# Testing: send EVERY email to this one address (each email says who it was really for).
EMAIL_REDIRECT_TO=
# off | outbox | resend  (normally chosen automatically)
EMAIL_MODE=

# Public address of the site — used for the links inside emails.
APP_URL=http://localhost:8070

# Time zone for timestamps saved by Postgres.
LVAEP_TZ=America/New_York
